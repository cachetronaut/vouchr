{
  "name": "vouchr",
  "version": "0.0.0",
  "description": "Portable Vouchr records and local export helpers for agent-fabric runs.",
  "keywords": [
    "vouchr",
    "receipts",
    "agent-fabric",
    "typescript",
    "esm"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./export-local": {
      "types": "./dist/export-local.d.ts",
      "import": "./dist/export-local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify && pnpm build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/cachetronaut/vouchr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachetronaut/vouchr.git"
  },
  "bugs": {
    "url": "https://github.com/cachetronaut/vouchr/issues"
  }
}
